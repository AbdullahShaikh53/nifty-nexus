# ---- Database (MySQL profile; the h2 profile ignores these) ----
MYSQL_DATABASE=niftynexus
MYSQL_USER=nexus
MYSQL_PASSWORD=nexuspass
MYSQL_ROOT_PASSWORD=rootpass
DB_URL=jdbc:mysql://localhost:3306/niftynexus?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true

# ---- Security ----
# Any random string of 48+ characters. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-48-characters-long

# ---- Market feed: mock (default, simulated ticks) or angelone ----
FEED_MODE=mock
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# ---- Demo / viva: bypass market hours (every use is audit-logged) ----
MARKET_SIMULATE_OPEN=true

# ---- Optional LLM coach (rule-based coach runs regardless) ----
COACH_LLM_ENABLED=false
COACH_LLM_API_KEY=
